{
  "info": {
    "name": "SupplyContractService - Microservicio C",
    "description": "Colección Postman para probar el microservicio C (SupplyContract) - Tercer Proyecto 2026A.\n\n**Puerto:** 8081\n**Base URL:** http://localhost:8081\n\nCubre las operaciones CRUD completas y las búsquedas con filtros.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "contractNumber",
      "value": "CNT-2024-001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Crear contrato",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contractNumber\": \"CNT-2024-001\",\n  \"totalValue\": 150000.50,\n  \"durationMonths\": 24,\n  \"status\": \"ACTIVE\",\n  \"signedAt\": \"2024-03-15T10:30:00\",\n  \"manufacturerId\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/contracts",
          "host": ["{{baseUrl}}"],
          "path": ["contracts"]
        },
        "description": "Crea un nuevo contrato de suministro. Retorna 201 Created.\n\n**Errores esperados:**\n- 400: datos inválidos (regex, valores negativos, fecha futura, etc.)\n- 409: ya existe un contrato con ese número"
      },
      "response": []
    },
    {
      "name": "2. Crear contrato - segundo registro",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contractNumber\": \"CNT-2024-002\",\n  \"totalValue\": 75000.00,\n  \"durationMonths\": 12,\n  \"status\": \"PENDING\",\n  \"signedAt\": \"2024-06-01T09:00:00\",\n  \"manufacturerId\": 2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/contracts",
          "host": ["{{baseUrl}}"],
          "path": ["contracts"]
        },
        "description": "Crea un segundo contrato para probar el listado."
      },
      "response": []
    },
    {
      "name": "3. Listar todos los contratos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/contracts",
          "host": ["{{baseUrl}}"],
          "path": ["contracts"]
        },
        "description": "Lista todos los contratos sin filtro."
      },
      "response": []
    },
    {
      "name": "4. Listar contratos por fabricante",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/contracts?manufacturerId=1",
          "host": ["{{baseUrl}}"],
          "path": ["contracts"],
          "query": [
            {
              "key": "manufacturerId",
              "value": "1"
            }
          ]
        },
        "description": "Filtra los contratos por id del fabricante."
      },
      "response": []
    },
    {
      "name": "5. Listar contratos por estado",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/contracts?status=ACTIVE",
          "host": ["{{baseUrl}}"],
          "path": ["contracts"],
          "query": [
            {
              "key": "status",
              "value": "ACTIVE",
              "description": "PENDING | ACTIVE | EXPIRED | CANCELLED"
            }
          ]
        },
        "description": "Filtra los contratos por estado."
      },
      "response": []
    },
    {
      "name": "6. Listar contratos por rango de valor",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/contracts?minValue=50000&maxValue=200000",
          "host": ["{{baseUrl}}"],
          "path": ["contracts"],
          "query": [
            {
              "key": "minValue",
              "value": "50000"
            },
            {
              "key": "maxValue",
              "value": "200000"
            }
          ]
        },
        "description": "Filtra los contratos cuyo valor total está dentro del rango."
      },
      "response": []
    },
    {
      "name": "7. Buscar contrato por número (PK)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/contracts/{{contractNumber}}",
          "host": ["{{baseUrl}}"],
          "path": ["contracts", "{{contractNumber}}"]
        },
        "description": "Obtiene un único contrato por su clave primaria.\n\n**Respuestas:**\n- 200: encontrado\n- 404: no existe"
      },
      "response": []
    },
    {
      "name": "8. Actualizar contrato",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contractNumber\": \"CNT-2024-001\",\n  \"totalValue\": 175000.75,\n  \"durationMonths\": 36,\n  \"status\": \"ACTIVE\",\n  \"signedAt\": \"2024-03-15T10:30:00\",\n  \"manufacturerId\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/contracts/{{contractNumber}}",
          "host": ["{{baseUrl}}"],
          "path": ["contracts", "{{contractNumber}}"]
        },
        "description": "Actualiza un contrato existente.\n\n**Respuestas:**\n- 200: actualizado\n- 404: no existe\n- 400: datos inválidos"
      },
      "response": []
    },
    {
      "name": "9. Eliminar contrato",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/contracts/{{contractNumber}}",
          "host": ["{{baseUrl}}"],
          "path": ["contracts", "{{contractNumber}}"]
        },
        "description": "Elimina un contrato por su número.\n\n**Respuestas:**\n- 204: eliminado\n- 404: no existe"
      },
      "response": []
    },
    {
      "name": "Casos de error",
      "description": "Pruebas de validación que deben fallar",
      "item": [
        {
          "name": "Error 400 - Número de contrato inválido (minúsculas)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contractNumber\": \"cnt-bad-001\",\n  \"totalValue\": 1000.00,\n  \"durationMonths\": 12,\n  \"status\": \"PENDING\",\n  \"signedAt\": \"2024-03-15T10:30:00\",\n  \"manufacturerId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/contracts",
              "host": ["{{baseUrl}}"],
              "path": ["contracts"]
            },
            "description": "El regex ^[A-Z0-9-]+$ debe rechazar minúsculas."
          },
          "response": []
        },
        {
          "name": "Error 400 - Valor total negativo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contractNumber\": \"CNT-2024-999\",\n  \"totalValue\": -500.00,\n  \"durationMonths\": 12,\n  \"status\": \"PENDING\",\n  \"signedAt\": \"2024-03-15T10:30:00\",\n  \"manufacturerId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/contracts",
              "host": ["{{baseUrl}}"],
              "path": ["contracts"]
            },
            "description": "@Positive debe rechazar valores negativos."
          },
          "response": []
        },
        {
          "name": "Error 400 - Duración mayor a 120 meses",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contractNumber\": \"CNT-2024-998\",\n  \"totalValue\": 1000.00,\n  \"durationMonths\": 200,\n  \"status\": \"PENDING\",\n  \"signedAt\": \"2024-03-15T10:30:00\",\n  \"manufacturerId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/contracts",
              "host": ["{{baseUrl}}"],
              "path": ["contracts"]
            },
            "description": "@Max(120) debe rechazar duraciones mayores a 120 meses."
          },
          "response": []
        },
        {
          "name": "Error 400 - Fecha de firma futura",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contractNumber\": \"CNT-2024-997\",\n  \"totalValue\": 1000.00,\n  \"durationMonths\": 12,\n  \"status\": \"PENDING\",\n  \"signedAt\": \"2099-01-01T00:00:00\",\n  \"manufacturerId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/contracts",
              "host": ["{{baseUrl}}"],
              "path": ["contracts"]
            },
            "description": "@PastOrPresent debe rechazar fechas futuras."
          },
          "response": []
        },
        {
          "name": "Error 400 - Estado inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contractNumber\": \"CNT-2024-996\",\n  \"totalValue\": 1000.00,\n  \"durationMonths\": 12,\n  \"status\": \"FOO\",\n  \"signedAt\": \"2024-03-15T10:30:00\",\n  \"manufacturerId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/contracts",
              "host": ["{{baseUrl}}"],
              "path": ["contracts"]
            },
            "description": "El enum ContractStatus solo acepta PENDING, ACTIVE, EXPIRED, CANCELLED."
          },
          "response": []
        },
        {
          "name": "Error 409 - Contrato duplicado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contractNumber\": \"CNT-2024-001\",\n  \"totalValue\": 1000.00,\n  \"durationMonths\": 12,\n  \"status\": \"PENDING\",\n  \"signedAt\": \"2024-03-15T10:30:00\",\n  \"manufacturerId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/contracts",
              "host": ["{{baseUrl}}"],
              "path": ["contracts"]
